<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_order_kanban_draggable" model="ir.ui.view">
            <field name="name">sale.order.kanban.confirm.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_kanban_with_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="records_draggable">true</attribute>
                    <attribute name="groups_draggable">true</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>