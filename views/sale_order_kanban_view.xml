<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Aplica na kanban base de sale.order para funcionar tanto no menu de
            Cotacoes quanto nas views derivadas de Pedidos de Venda.
        -->
        <record id="view_sale_order_kanban_draggable" model="ir.ui.view">
            <field name="name">sale.order.kanban.confirm.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
            <field name="arch" type="xml">

                <!-- Habilita drag-and-drop e forca agrupamento por state. -->
                <xpath expr="//kanban" position="attributes">
                    <attribute name="records_draggable">1</attribute>
                    <attribute name="default_group_by">state</attribute>
                </xpath>

                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="readonly">False</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
